   "fieldtype": "Select",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Direction",
   "options": "\nExport\nImport\nCopy\nCheck",
   "reqd": 1,
   "set_only_once": 1
  },
  {
   "description": "What the bundle carries. An import reads it from the file.",
