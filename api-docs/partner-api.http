# ────────────────────────────────────────────────────────────── ACTIVITIES

### Activity Schema — BY LEAD. The types and fields vary by the lead's grain.
GET {{baseUrl}}/api/method/tatva_connect.api.partner_activity.activity_schema?lead={{leadName}}
Authorization: token {{token}}

> {%
    client.test("discovery is per lead", function () {
        const d = response.body.data;
        client.assert(d.entity === "activity");
        client.assert(d.lead === client.global.get("leadName"));
        client.assert(Array.isArray(d.task_types), "task_types must be a list");
    });
    if (response.body.data.task_types.length > 0) {
        client.global.set("taskType", response.body.data.task_types[0].name);
        client.log("using task_type: " + response.body.data.task_types[0].name);
    } else {
        client.log("no activity type is configured for this grain -- the activity requests will 400");
    }
%}

### Create Activity
POST {{baseUrl}}/api/method/tatva_connect.api.partner_activity.activity_create
Authorization: token {{token}}
Content-Type: application/json

{
  "lead": "{{leadName}}",
  "task_type": "{{taskType}}",
  "external_id": "HTTPC-ACT-1",
  "values": {}
}

> {%
    client.test("an activity is created and addressable", function () {
        client.assert(response.body.action === "created");
        client.assert(typeof response.body.data.name === "string" && response.body.data.name.length > 0,
            "every entity returns a STRING address -- CRM Task is autoincrement-named, so this is coerced");
    });
    client.global.set("activityName", response.body.data.name);
%}

### List a lead's Activities, filtered by the SAME task_type the create accepted
GET {{baseUrl}}/api/method/tatva_connect.api.partner_activity.activity_list?lead={{leadName}}&task_type={{taskType}}&limit=20
Authorization: token {{token}}

> {%
    client.test("the list filter speaks the create's vocabulary", function () {
        const names = response.body.data.activities.map(a => a.name);
        client.assert(names.indexOf(client.global.get("activityName")) >= 0,
            "filtering by the task_type the create just accepted did not find the activity");
    });
%}

### Bulk Read Activities
POST {{baseUrl}}/api/method/tatva_connect.api.partner_activity.activity_get_bulk
Authorization: token {{token}}
Content-Type: application/json

{
  "names": ["{{activityName}}", "DOES-NOT-EXIST"]
}

> {%
    client.test("one summary shape", function () {
        const s = response.body.summary;
        client.assert(s.total === 2 && s.succeeded === 1 && s.failed === 1, JSON.stringify(s));
    });
%}

### Delete Activity
# An activity that has been worked carries linked records (a visit audit is written on completion),
# and a delete is then refused with 409 cannot_delete. Both outcomes are correct; a partner must
# branch on error.code, never on the message.
DELETE {{baseUrl}}/api/method/tatva_connect.api.partner_activity.activity_delete?name={{activityName}}
Authorization: token {{token}}

> {%
    client.test("deleted, or refused because it has linked records", function () {
        if (response.status === 200) {
            client.assert(response.body.action === "deleted");
        } else {
            client.assert(response.status === 409, "expected 200 or 409, got " + response.status);
            client.assert(response.body.error.code === "cannot_delete");
            client.assert(response.body.error.message.toLowerCase().indexOf("lead") < 0,
                "the shared message must not name one entity");
        }
    });
%}

# ────────────────────────────────────────────────────────────────── FILES

### File Schema
GET {{baseUrl}}/api/method/tatva_connect.api.partner_file.file_schema
Authorization: token {{token}}

> {%
    client.test("discovery states the attach contract", function () {
        const d = response.body.data;
        client.assert(d.entity === "file");
        client.assert(d.identity.addressed_by === "name");
        client.assert(d.immutable.length > 0, "the no-update decision must be stated");
    });
    client.test("filename is required, external_id is not", function () {
        const f = response.body.data.fields;
        client.assert(f.filter(x => x.fieldname === "filename")[0].required === true);
        client.assert(f.filter(x => x.fieldname === "external_id")[0].required === false);
    });
%}

### Attach File (base64)
POST {{baseUrl}}/api/method/tatva_connect.api.partner_file.file_attach
Authorization: token {{token}}
Content-Type: application/json

{
  "lead": "{{leadName}}",
  "filename": "httpclient-probe.txt",
  "file_type": "Prescription",
  "content_base64": "SFRUUCBDbGllbnQgcHJvYmU=",
  "external_id": "HTTPC-FILE-1"
}

> {%
    client.test("a file is attached, private, behind a proxy url", function () {
        client.assert(response.body.action === "created");
        client.assert(response.body.data.is_private === true, "every partner file must be private");
        client.assert(response.body.data.file_url.indexOf("/private/files/") !== 0,
            "file_url must be a proxy url, never a raw storage path");
    });
    client.global.set("fileName", response.body.data.name);
%}

### Get File by name
GET {{baseUrl}}/api/method/tatva_connect.api.partner_file.file_get?name={{fileName}}
Authorization: token {{token}}

> {%
    client.test("a file is addressable by the name its attach returned", function () {
        client.assert(response.body.data.name === client.global.get("fileName"));
    });
%}

### List a lead's Files — must include files homed on an activity or a note, not just the lead
GET {{baseUrl}}/api/method/tatva_connect.api.partner_file.file_list?lead={{leadName}}&limit=20
Authorization: token {{token}}

> {%
    client.test("the file appears in the only enumeration surface the API has", function () {
        const names = response.body.data.files.map(f => f.name);
        client.assert(names.indexOf(client.global.get("fileName")) >= 0,
            "an attached file is invisible to file_list");
    });
%}

