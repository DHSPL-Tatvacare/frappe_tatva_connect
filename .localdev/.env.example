# Local stack settings. Copy to .env (which git ignores) and fill in the two passwords. Local values only, never a real secret.

# The image built from the repo's Containerfile.
CUSTOM_IMAGE=tatva-frappe
CUSTOM_TAG=local

# The local site (same variable name as prod) and its passwords.
SITE_NAME=dev.localhost
DB_PASSWORD=
ADMIN_PASSWORD=

# The two app repos, bind-mounted live. Leave blank when they are cloned side by side:
#   <folder>/frappe_tatva_connect   and   <folder>/frappe_tatva_crm
CONNECT_REPO=
CRM_REPO=

# Browser port for nginx, bound to 127.0.0.1 so only this machine can reach it.
APP_PUBLISH=8080

# Azure Blob storage. Leave both blank to keep files on the local disk; nothing breaks.
# To test offload, ask the team for the local container name and its connection string.
STORAGE_ENV=
STORAGE_CONN=
