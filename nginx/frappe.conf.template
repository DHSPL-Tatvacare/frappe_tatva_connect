# Docker's embedded DNS: an upstream{} name is resolved once at startup and cached for the life of the process, so a container restart leaves nginx dialling a dead IP.
resolver 127.0.0.11 valid=10s ipv6=off;

# X-Forwarded-Proto if the edge set it, else the scheme we were reached on.
map $http_x_forwarded_proto $proxy_x_forwarded_proto {
	default $scheme;
	https https;
}

server {
	listen 8080;
	server_name ${FRAPPE_SITE_NAME_HEADER};
	absolute_redirect off;
	server_tokens off;
	root /home/frappe/frappe-bench/sites;

	include /etc/nginx/snippets/security_headers.conf;

	set_real_ip_from ${UPSTREAM_REAL_IP_ADDRESS};
	real_ip_header ${UPSTREAM_REAL_IP_HEADER};
	real_ip_recursive ${UPSTREAM_REAL_IP_RECURSIVE};

	# --- Static ---

	# TATVA: Zudoku API docs, SSG'd into the active site's public dir by api-docs/deploy-docs.sh.
	location /docs {
		root /home/frappe/frappe-bench/sites/${FRAPPE_SITE_NAME_HEADER}/public;
		try_files $uri $uri.html $uri/index.html /docs/index.html;
	}

	location /assets {
		try_files $uri =404;
	}

	# Private files, reachable only via the backend's X-Accel-Redirect.
	location ~ ^/protected/(.*) {
		internal;
		try_files /${FRAPPE_SITE_NAME_HEADER}/$1 =404;
	}

	location /socket.io {
		proxy_http_version 1.1;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection "upgrade";
		proxy_set_header X-Frappe-Site-Name ${FRAPPE_SITE_NAME_HEADER};
		proxy_set_header Origin $proxy_x_forwarded_proto://${FRAPPE_SITE_NAME_HEADER};
		proxy_set_header Host $host;

		# A variable target is what forces per-request re-resolution; no URI part, so nginx keeps its own URI handling.
		set $socketio_upstream "${SOCKETIO}";
		proxy_pass http://$socketio_upstream;
	}

	# --- TATVA inbound webhooks: /webhooks/<channel>/<token> — no vendor segment so a vendor swap is config, <token> is auth + account identity (webhooks.ingress.verify), `last` reuses @webserver ---

	location ~ ^/webhooks/whatsapp/(?<whatsapp_token>[^/]+)/?$ {
		rewrite ^ /api/method/tatva_connect.whatsapp.webhook.webhook?token=$whatsapp_token last;
	}

	location ~ ^/webhooks/voice/(?<voice_token>[^/]+)/?$ {
		rewrite ^ /api/method/tatva_connect.voice.webhook.webhook?token=$voice_token last;
	}

	# Text, not audio, on the same spine: without this line the POST falls through to the SPA, the handler never runs, and every transcript is lost with not even a raw delivery row to show it arrived.
	location ~ ^/webhooks/transcription/(?<transcription_token>[^/]+)/?$ {
		rewrite ^ /api/method/tatva_connect.storage.transcription_channel.webhook?token=$transcription_token last;
	}

	# Event is constrained to the four literals, so no other handler method is reachable.
	location ~ ^/webhooks/telephony/acefone/(?<tel_token>[^/]+)/(?<tel_event>inbound_answered|inbound_complete|outbound_answered|outbound_complete)/?$ {
		rewrite ^ /api/method/tatva_connect.telephony.handler.$tel_event?token=$tel_token last;
	}

	# --- TATVA MCP: the protocol wants ONE endpoint path, so /mcp is the address and the method is ours ---

	location = /mcp {
		rewrite ^ /api/method/tatva_connect.mcp.server.endpoint last;
	}

	# --- Everything else ---

	location / {
		rewrite ^(.+)/$ $1 permanent;
		rewrite ^(.+)/index\.html$ $1 permanent;
		rewrite ^(.+)\.html$ $1 permanent;

		# Re-included because a nested add_header would otherwise drop the inherited security headers.
		location ~ ^/files/.*.(htm|html|svg|xml) {
			include /etc/nginx/snippets/security_headers.conf;
			add_header Content-disposition "attachment";
			try_files /${FRAPPE_SITE_NAME_HEADER}/public/$uri @webserver;
		}

		try_files /${FRAPPE_SITE_NAME_HEADER}/public/$uri @webserver;
	}

	location @webserver {
		proxy_http_version 1.1;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
		proxy_set_header X-Frappe-Site-Name ${FRAPPE_SITE_NAME_HEADER};
		proxy_set_header Host $host;
		proxy_set_header X-Use-X-Accel-Redirect True;
		proxy_read_timeout ${PROXY_READ_TIMEOUT};
		proxy_redirect off;

		# Same re-resolution; no URI part is load-bearing — spelling one out drops the webhook/mcp rewrites ($request_uri) or the percent-encoding in /api/resource/CRM%20Lead ($uri).
		set $backend_upstream "${BACKEND}";
		proxy_pass http://$backend_upstream;
	}

	# --- Tuning ---

	proxy_buffer_size 128k;
	proxy_buffers 4 256k;
	proxy_busy_buffers_size 256k;
	sendfile on;
	keepalive_timeout 15;
	client_max_body_size ${CLIENT_MAX_BODY_SIZE};
	client_body_buffer_size 16K;
	client_header_buffer_size 1k;

	# --- Compression (text/html is always compressed by HttpGzipModule) ---

	gzip on;
	gzip_http_version 1.1;
	gzip_comp_level 5;
	gzip_min_length 256;
	gzip_proxied any;
	gzip_vary on;
	gzip_types
		application/atom+xml
		application/javascript
		application/json
		application/rss+xml
		application/vnd.ms-fontobject
		application/x-font-ttf
		application/font-woff
		application/x-web-app-manifest+json
		application/xhtml+xml
		application/xml
		font/opentype
		image/svg+xml
		image/x-icon
		text/css
		text/plain
		text/x-component;
}
